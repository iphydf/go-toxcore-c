load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//tools/project:build_defs.bzl", "project")

project(license = "gpl3-https")

go_library(
    name = "go_default_library",
    srcs = [
        "cgo.go",
        "conference.go",
        "conference_errors.go",
        "conference_events.go",
        "errors.go",
        "events.go",
        "file.go",
        "friend.go",
        "group.go",
        "group_errors.go",
        "group_events.go",
        "log.go",
        "options.go",
        "tox.go",
        "types.go",
    ],
    cdeps = ["//c-toxcore"],
    cgo = True,
    importpath = "github.com/TokTok/go-toxcore-c",
    visibility = ["//visibility:public"],
    deps = [
        "//go-toxcore-c/internal/cname",
        "//go-toxcore-c/internal/handle",
    ],
)

go_test(
    name = "go_default_test",
    size = "large",
    srcs = ["tox_test.go"],
    race = "on",
    deps = [
        ":go_default_library",
        "//go-toxcore-c/internal/toxtest",
    ],
)
